# Copy to .env and fill in only what you use. Every variable is optional.
# Nothing here is required for the offline quickstart (STICKERLOOM_PROVIDER=fake).

# Which model provider fulfils generation jobs: higgsfield (default, needs the
# Higgsfield CLI + login) | fake (deterministic offline renders, no account) |
# openai (experimental stills via your own key, needs stickerloom[openai])
# STICKERLOOM_PROVIDER=higgsfield

# Where a run writes its files (default: ./out)
# STICKERLOOM_OUT=out

# Approval gates: manual (a human approves every gate) | auto (verifier-passing
# auto-approves, judgement calls auto-overridden, TECHNICAL stops) | off (no gate
# pauses; verification still runs and TECHNICAL failures still block the pack).
# Default: manual. Also `create --gates ...` and Studio Settings.
# STICKERLOOM_GATES=manual

# Chat/vision language models (default STICKERLOOM_LLM_PROVIDER=auto: a local
# LM Studio/Ollama endpoint when it answers, else the cloud when configured,
# else none with a clear message). Local: STICKERLOOM_LOCAL_URL
# (default http://localhost:1234/v1), STICKERLOOM_LOCAL_MODEL (a wish; the
# server's own list decides). Cloud: official OpenAI needs OPENAI_API_KEY.
# A generic OpenAI-compatible fallback endpoint (all unset by default):
# its base URL (required to enable it), its key (some self-hosted endpoints
# need none), its default model. Vision retries here once on failure.
# STICKERLOOM_FALLBACK_URL=
# STICKERLOOM_FALLBACK_KEY=
# STICKERLOOM_FALLBACK_MODEL=
# Optional curated model lists (comma-separated; empty means none):
# official OpenAI chat set and its image-capable subset
# STICKERLOOM_OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol
# STICKERLOOM_OPENAI_VISION=gpt-4o-mini,gpt-6.1-sol
# fallback endpoint's curated set (unset: show whatever the endpoint lists)
# and its image-capable subset (unset: assume the shown ones are)
# STICKERLOOM_FALLBACK_MODELS=
# STICKERLOOM_FALLBACK_VISION=

# Chat/vision language model provider: openai | local | auto | none
# (default auto: the local server when it answers, else the cloud when a key
# is set, else none with a clear message). The test suite pins `none`.
# STICKERLOOM_LLM_PROVIDER=auto

# HTTP timeout in seconds for provider and model calls. Unset keeps each
# caller's built-in timeout (for example the agent brain uses 45 s).
# STICKERLOOM_HTTP_TIMEOUT=

# Daily cap on paid credits: generation/jobs.py refuses new paid calls once
# the spend ledgered since local midnight reaches this (unset: no cap; the
# paid-call consent still applies to every call).
# STICKERLOOM_DAILY_CREDITS=

# --- Vision judge (stickerloom/vision/; bare VISION_* still works, legacy) ---
# Endpoint override + model override (unset: follow STICKERLOOM_VISION_PROVIDER
# local|openai|auto, default auto), per-call timeout (90 s), token cap (700),
# parallel calls (2), down-model policy (FAIL_CLOSED keeps the sticker READY
# and marks it unjudged; DETERMINISTIC_ONLY stays silent), cloud model pin.
# STICKERLOOM_VISION_BASE_URL=
# STICKERLOOM_VISION_MODEL=
# STICKERLOOM_VISION_TIMEOUT=90
# STICKERLOOM_VISION_MAX_TOKENS=700
# STICKERLOOM_VISION_CONCURRENCY=2
# STICKERLOOM_VISION_PROVIDER=auto
# STICKERLOOM_VISION_POLICY=FAIL_CLOSED
# STICKERLOOM_VISION_OPENAI_MODEL=

# --- Telegram send (stickerloom/services/telegram.py) ---
# Bot API endpoint (default https://api.telegram.org), bot token and the
# owner chat id receipts go to.
# STICKERLOOM_TELEGRAM_API=https://api.telegram.org
# STICKERLOOM_TELEGRAM_TOKEN=
# STICKERLOOM_TELEGRAM_USER=

# --- Console server (stickerloom serve) ---
# Bind address (unset: localhost), TLS cert/key pair (unset: plain HTTP),
# access log path (unset: none), job runner (queue = Postgres-backed, unset =
# threads), per-job timeout in seconds (1200), animation workers (unset:
# automatic), paid jobs in flight (3).
# STICKERLOOM_SERVER=
# STICKERLOOM_TLS_CERT=
# STICKERLOOM_TLS_KEY=
# STICKERLOOM_ACCESS_LOG=
# STICKERLOOM_JOB_MODE=
# STICKERLOOM_JOB_TIMEOUT=1200
# STICKERLOOM_ANIM_WORKERS=
# STICKERLOOM_PAID_PARALLEL=3

# --- LLM tuning (stickerloom/services/llm.py) ---
# Model pins and fallbacks (unset: follow STICKERLOOM_LLM_PROVIDER), the chat
# assistant's provider (local|openai|auto|none, default auto) and model, local
# token floor when reasoning can't switch off (2048), prefill (1), reasoning
# effort (none), local probe timeout in seconds (15).
# STICKERLOOM_LLM_MODEL=
# STICKERLOOM_LLM_FALLBACK=
# STICKERLOOM_AI_BACKEND=
# STICKERLOOM_AGENT_PROVIDER=auto
# STICKERLOOM_AGENT_MODEL=
# STICKERLOOM_LOCAL_MIN_TOKENS=2048
# STICKERLOOM_LOCAL_PREFILL=1
# STICKERLOOM_LOCAL_REASONING=none
# STICKERLOOM_AUTO_LOCAL_TIMEOUT=15
# Semantic search embeddings: provider (auto) and model
# (text-embedding-nomic-embed-text-v1.5).
# STICKERLOOM_EMBED_PROVIDER=auto
# STICKERLOOM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Media and model paths ---
# ffmpeg binary (unset: PATH, then the imageio-ffmpeg bundle), cutout model
# file (unset: auto-fetch to the models dir), Higgsfield CLI binary (unset:
# PATH), handpicked-animation drop zone (unset: the packaged lottie/ dir),
# prefer prepared inputs when
# both exist, shortlist score floors (0.40 action, 0.50 subject).
# STICKERLOOM_FFMPEG=
# STICKERLOOM_MATTE_MODEL=
# STICKERLOOM_HIGGSFIELD_BIN=
# STICKERLOOM_LOTTIE_DIR=
# STICKERLOOM_PREFER_PREPARED=
# STICKERLOOM_POOL_ACTION_MIN=0.40
# STICKERLOOM_POOL_SUBJECT_MIN=0.50

# --- State backends (all optional; memory/file fallbacks apply) ---
# Postgres (unset: postgresql://stickerloom:stickerloom_local@localhost:5434/
# stickerloom; the bare DATABASE_URL is read as a legacy fallback — the second
# sanctioned non-STICKERLOOM_* name), Redis (default redis://localhost:6380/0,
# else memory), activity log (1), watch-folders dir override, Postgres
# write-through toggle (0|no|off|false disables).
# STICKERLOOM_DATABASE_URL=
# STICKERLOOM_REDIS_URL=redis://localhost:6380/0
# STICKERLOOM_ACTIVITY=1
# STICKERLOOM_INPUT=
# STICKERLOOM_DB_WRITE=

# --- API keys ---
# Stills provider key (openai provider). The chat/vision cloud key is the bare
# OPENAI_API_KEY — one of two sanctioned non-STICKERLOOM_* names (the other is
# DATABASE_URL above), kept because every OpenAI-compatible tool reads it.
# STICKERLOOM_OPENAI_API_KEY=
# OPENAI_API_KEY=

# --- Test-only ---
# STICKERLOOM_NO_REAL_CLI=1 forces every provider subprocess to its fake
# double. The test suite sets it; never set it for real runs.
